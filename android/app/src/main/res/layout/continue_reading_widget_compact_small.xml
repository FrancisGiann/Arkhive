<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/continue_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/continue_widget_open_library">

    <ImageView android:id="@+id/continue_bookplate_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/continue_reading_compact_card"
        android:importantForAccessibility="no"/>

    <LinearLayout android:id="@+id/continue_bookplate_content"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="5dp">
        <LinearLayout android:id="@+id/continue_bookplate_main"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <ImageView android:id="@+id/continue_bookplate_cover"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="0.94" android:background="@drawable/continue_reading_compact_cover"
                android:clipToOutline="true" android:scaleType="centerCrop"
                android:src="@drawable/readingapp_icon" android:contentDescription="@string/continue_widget_cover_description"
                android:importantForAccessibility="no"/>
            <LinearLayout android:id="@+id/continue_bookplate_copy"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="6dp"
                android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/continue_bookplate_title"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:fontFamily="@font/ink_display" android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp" android:maxLines="4" android:includeFontPadding="false"
                    android:ellipsize="end" android:text="Your next chapter"/>
                <LinearLayout android:id="@+id/continue_bookplate_progress"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                        <ImageView android:id="@+id/continue_bookplate_ring"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:importantForAccessibility="no"/>
                        <TextView android:id="@+id/continue_bookplate_percent"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:fontFamily="@font/ink_body"
                            android:textColor="#FFFFFFFF" android:textSize="7.5sp"
                            android:includeFontPadding="false" android:text="17%"/>
                    </FrameLayout>
                    <TextView android:id="@+id/continue_bookplate_count"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" android:fontFamily="@font/ink_display"
                        android:textColor="#FFFFFFFF" android:textSize="10.7sp"
                        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                        android:text="19 / 110"/>
                    <TextView android:id="@+id/continue_bookplate_read_label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="1.8dp" android:fontFamily="@font/ink_body"
                        android:textColor="#FFE5DEEC" android:textSize="7.5sp"
                        android:includeFontPadding="false" android:maxLines="1" android:text="read"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/continue_bookplate_resume"
            android:layout_width="match_parent" android:layout_height="29dp"
            android:layout_marginTop="4dp" android:background="@drawable/continue_reading_compact_resume_small"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:contentDescription="@string/continue_widget_open_library">
            <TextView android:id="@+id/continue_bookplate_resume_text"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center_vertical" android:fontFamily="@font/ink_body"
                android:textColor="#FF2E2441" android:textStyle="bold" android:textSize="11.5sp"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:importantForAccessibility="no" android:text="Open library"/>
            <TextView android:id="@+id/continue_bookplate_resume_arrow"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:fontFamily="@font/ink_body" android:text="→"
                android:textColor="#FF2E2441" android:textSize="15sp" android:includeFontPadding="false"
                android:importantForAccessibility="no"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
