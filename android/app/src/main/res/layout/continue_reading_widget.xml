<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/continue_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/continue_background" android:src="@drawable/continue_reading_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@android:color/transparent">
<TextView android:id="@+id/continue_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONTINUE READING" android:textColor="@color/continue_ink" android:fontFamily="@font/ink_body" android:textStyle="bold" android:textSize="10sp" android:letterSpacing="0.12" android:maxLines="1"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingTop="12dp">
<ImageView android:id="@+id/continue_cover" android:src="@drawable/readingapp_icon" android:layout_width="76dp" android:layout_height="match_parent" android:layout_marginEnd="16dp" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
<TextView android:id="@+id/continue_title" android:text="YOUR NEXT CHAPTER" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/continue_ink" android:fontFamily="@font/ink_display" android:textSize="22sp" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/continue_author" android:text="Pick up your story" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/continue_ink" android:fontFamily="@font/ink_body" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/continue_kind" android:text="ARKHIVE" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/continue_ink" android:textStyle="bold" android:textSize="10sp" android:maxLines="1"/>
<TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
<ImageView android:scaleType="fitXY" android:importantForAccessibility="no" android:id="@+id/continue_progress" android:layout_width="match_parent" android:layout_height="3dp" android:background="@color/continue_track"/>
<TextView android:id="@+id/continue_status" android:text="Saved reading progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/continue_ink" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout></LinearLayout>
<TextView android:id="@+id/continue_resume" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="end|center_vertical" android:text="RESUME  →" android:textStyle="bold" android:textColor="@color/continue_ink" android:textSize="12sp" android:importantForAccessibility="no"/>
</LinearLayout></FrameLayout>